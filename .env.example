# Copy this file to .env and fill in your values. Never commit .env.

# Frontend (Vite) — required for the app
# Safe to expose: Publishable Key (sb_publishable_...)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: GitHub Pages base path
# GITHUB_PAGES=true

# --- json_converter/sync_smart.js (local sync only) ---
# For local testing only. For GitHub Actions, use GitHub Secrets instead.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
