# Copy this file to .env and fill in your values. Never commit .env.

# Main app uses local msgpack/JSON only — no Supabase or other DB required to run the app.

# Optional: GitHub Pages base path
# GITHUB_PAGES=true

# --- json_converter/sync_smart.js (optional, for backoffice sync only) ---
# Only needed if you run the JSON→CSV sync to a Supabase project. For GitHub Actions, use GitHub Secrets.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
